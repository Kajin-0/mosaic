  "info": {
    "description": "Server-authoritative Mosaic API boundary. Phase 4 calibration behavior is a deterministic persisted infrastructure trial, not validated relationship-science inference.",
    "title": "Mosaic Engine API",
    "version": "2026-08-14.2"
  },
  "openapi": "3.1.0",
  "paths": {
