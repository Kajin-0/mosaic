# Hosted projects: use the Project URL and a publishable sb_publishable_... key.
# Local development: use the API_URL and ANON_KEY emitted by `npx supabase status -o env`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Android emulators normally reach the host at 10.0.2.2 rather than 127.0.0.1.
# Use the address appropriate for the current development target.
EXPO_PUBLIC_MOSAIC_ENGINE_URL=http://127.0.0.1:8000
